<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>
  <groupId>com.pso</groupId>
  <artifactId>pso-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>PSO Java ecosystem (parent)</name>
  <description>Spring Boot starters, auto-configuration and APIs for PSO Web microservices.</description>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <modules>
    <module>pso-bom</module>
    <module>pso-dispatch-api</module>
    <module>pso-dispatch-test</module>
    <module>pso-spring-boot-autoconfigure</module>
    <module>pso-spring-boot-starter</module>
    <module>pso-security-spring-boot-starter</module>
    <module>pso-http-spring-boot-starter</module>
    <module>pso-data-spring-boot-starter</module>
    <module>pso-storage-spring-boot-starter</module>
    <module>pso-channels-spring-boot-starter</module>
    <module>pso-dispatch-redis-starter</module>
    <module>pso-dispatch-rabbitmq-starter</module>
    <module>pso-dispatch-kafka-starter</module>
    <module>pso-ratelimit-redis-starter</module>
    <module>pso-observability-starter</module>
    <module>pso-test</module>
    <module>pso-integration-tests</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs><arg>-Xlint:all,-processing,-serial</arg></compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
