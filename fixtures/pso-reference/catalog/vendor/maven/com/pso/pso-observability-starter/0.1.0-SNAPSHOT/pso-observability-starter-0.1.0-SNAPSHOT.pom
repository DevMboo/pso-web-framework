<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.pso</groupId><artifactId>pso-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>pso-observability-starter</artifactId>
  <name>PSO observability starter</name>
  <description>Optional: OpenTelemetry traces (W3C propagation) and metrics for PSO services through Micrometer and the official OpenTelemetry exporters. Nothing is exported unless OTEL_EXPORTER_OTLP_ENDPOINT (or the management.otlp.* properties) is set.</description>
  <dependencies>
    <dependency><groupId>com.pso</groupId><artifactId>pso-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-tracing-bridge-otel</artifactId></dependency>
    <dependency><groupId>io.opentelemetry</groupId><artifactId>opentelemetry-exporter-otlp</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-otlp</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
