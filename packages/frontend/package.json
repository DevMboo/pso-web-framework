  "license": "Apache-2.0",
  "author": "DevMboo",
  "homepage": "https://devmboo.github.io/pso-web-docs/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "default": "./dist/release.js"
    }
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "bin",
    "!**/*.map",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "description": "PSO Web framework: declarative FEI/MEI contracts, routing, middleware, manifests and build tooling for distributed React frontends",
  "bin": {
    "pso-frontend": "./bin/pso-frontend.js"
  }
}
