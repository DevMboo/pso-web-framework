  "homepage": "https://devmboo.github.io/pso-web-docs/",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/security packages/dispatch packages/http packages/channels-client packages/react-channels packages/channels packages/deploy packages/frontend packages/frontend-client packages/frontend-react packages/infra packages/cli && node scripts/bundle-agent.mjs && node scripts/gen-diagnostic-codes.mjs",
    "typecheck": "tsc -b packages/core packages/dispatch packages/http packages/cli",
    "test": "npm run build && node --test --test-concurrency=4 --test-timeout=300000 \"packages/*/test/*.test.ts\""
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.9.3",
    "@module-federation/runtime": "^2.9.3",
    "@peculiar/x509": "^1.14.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.0",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "jose": "^6.2.18",
    "playwright-core": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/amqplib": "^0.10.8",
    "amqplib": "^0.10.9",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "ws": "^8.23.0"
  }
}
